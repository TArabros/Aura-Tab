{
  "manifest_version": 3,
  "name": "Nova Tab",
  "version": "1.0.0",
  "description": "Your personal command center — a premium new tab experience with shortcuts, media control, and AI assistant.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.youtube.com/*",
    "*://*.spotify.com/*",
    "*://*.soundcloud.com/*",
    "*://*.vk.com/*",
    "*://*.yandex.ru/*",
    "*://*.deezer.com/*",
    "*://*.apple.com/*",
    "*://*.tidal.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.music.youtube.com/*",
        "*://*.spotify.com/*",
        "*://*.soundcloud.com/*",
        "*://*.vk.com/*",
        "*://*.yandex.ru/*",
        "*://*.deezer.com/*",
        "*://*.apple.com/*",
        "*://*.tidal.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
